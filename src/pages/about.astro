---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NeuralMesh from '../components/NeuralMesh.astro';
import { SITE_URL, SITE_AUTHOR, LINKEDIN_URL, GITHUB_URL, X_URL, BLITZ_URL } from '../consts';

const aboutDescription = "Karthik Mahalingam — engineering leader at Microsoft and independent researcher on how AI agents make decisions, and how those decisions can be scored and verified.";

const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"mainEntity": {
		"@type": "Person",
		"name": SITE_AUTHOR,
		"url": SITE_URL + "/about/",
		"description": aboutDescription,
		"jobTitle": "Engineering Leader",
		"worksFor": { "@type": "Organization", "name": "Microsoft" },
		"sameAs": [LINKEDIN_URL, X_URL, GITHUB_URL],
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL + "/" },
		{ "@type": "ListItem", "position": 2, "name": "About" },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About | LatentMesh"
			description={aboutDescription}
			image="/og-default.png"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<NeuralMesh seed={23} />
		<Header />
		<main class="about">
			<section class="intro">
				<h1>About</h1>
				<p>
					LatentMesh is independent research by {SITE_AUTHOR} on how AI agents
					make decisions.
				</p>
			</section>

			<section class="block">
				<h2 class="label">Background</h2>
				<p>
					I'm an engineering leader at Microsoft with 19+ years of experience
					building systems at scale. I lead engineering in Purview Data Lifecycle
					Management, building retention, compliance, and governance services
					for large enterprise environments.
				</p>
				<p>
					Over the past several years my focus has moved toward AI: agent
					systems, evaluation pipelines, retrieval architectures, and compliance
					automation. That background shapes how I approach AI: not only as a
					model problem, but as a systems problem.
				</p>
			</section>

			<section class="block">
				<h2 class="label">Research</h2>
				<p>
					Most work on AI focuses on what models can do. I'm more interested in
					what happens once an agent is deployed and has to act: which decision
					it made, how confident it was, and whether anyone can check that later.
				</p>
				<p>
					LatentMesh approaches that from two directions: making agent decisions
					fast enough to score directly, and making them verifiable after the
					fact. <a href={BLITZ_URL} onclick="gtag('event','outbound_click',{destination:'blitz',location:'about'})">Blitz</a> is
					the first public research preview of that work.
				</p>
			</section>

			<section id="contact" class="block">
				<h2 class="label">Contact</h2>
				<p>
					For research questions or collaboration:
					<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" onclick="gtag('event','outbound_click',{destination:'linkedin',location:'about'})">LinkedIn</a>
					or
					<a href={X_URL} target="_blank" rel="noopener noreferrer" onclick="gtag('event','outbound_click',{destination:'x',location:'about'})">X (@karthiksync)</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 760px;
		min-height: calc(100vh - 16rem);
		margin: 0 auto;
		padding: 7rem 1.25rem 0;
		font-size: 1rem;
		color: var(--color-text-body);
	}

	.about a {
		color: var(--color-text-primary);
		text-decoration-color: var(--color-border);
		text-underline-offset: 3px;
	}

	.about a:hover {
		text-decoration-color: var(--highlight);
		text-decoration-thickness: 3px;
	}

	.intro h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.6rem);
		font-weight: 650;
		line-height: 1.12;
		letter-spacing: -0.035em;
		margin: 0 0 1.25rem;
	}

	.intro p {
		max-width: 58ch;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.block {
		margin-top: 3.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 1.25rem;
	}

	.block p {
		max-width: 62ch;
		line-height: 1.65;
		color: var(--color-text-secondary);
		margin: 0 0 1rem;
	}

	.block p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		.about {
			padding: 3rem 1rem 0;
		}
	}
</style>
