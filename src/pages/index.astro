---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NeuralMesh from "../components/NeuralMesh.astro";
import { SITE_DESCRIPTION, SITE_URL, SITE_AUTHOR, LINKEDIN_URL, GITHUB_URL, BLITZ_DEMO_URL, X_URL } from "../consts";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "LatentMesh",
  "alternateName": "LatentMesh AI",
  "url": SITE_URL + "/",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "name": "LatentMesh",
  "url": SITE_URL + "/",
  "description": SITE_DESCRIPTION,
  "founder": { "@type": "Person", "name": SITE_AUTHOR, "url": SITE_URL + "/about/" },
  "sameAs": [LINKEDIN_URL, X_URL, GITHUB_URL],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="LatentMesh — Research on how AI agents make decisions" description={SITE_DESCRIPTION} image="/og-default.png" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <NeuralMesh />
    <Header />

    <main class="home">
      <section class="intro">
        <h1>Research on how AI agents make decisions.</h1>
        <p>
          LatentMesh is independent research by <a href="/about/">{SITE_AUTHOR}</a>.
          The work asks two questions: how can an agent's decisions be made fast
          enough to score directly, and how can they be verified after the fact?
        </p>
      </section>

      <section id="research" class="block">
        <h2 class="label">Research</h2>
        <article class="entry">
          <div class="entry-head">
            <a href={BLITZ_DEMO_URL} class="entry-title" onclick="gtag('event','outbound_click',{destination:'blitz',location:'homepage'})">Blitz: an ultra-low-latency decision model</a>
            <span class="tag">Research preview</span>
          </div>
          <p class="entry-desc">
            22 ms of model time per decision, at about USD 1.30 per million
            requests. It answers a panel of focused questions with one forward
            pass. Papers coming soon.
          </p>
          <a href={BLITZ_DEMO_URL} class="entry-link" onclick="gtag('event','outbound_click',{destination:'blitz',location:'homepage_link'})">Try the demo &rarr;</a>
        </article>
      </section>

      <section id="contact" class="block">
        <h2 class="label">Contact</h2>
        <p class="contact">
          For research questions or collaboration:
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" onclick="gtag('event','outbound_click',{destination:'linkedin',location:'homepage'})">LinkedIn</a>
          or
          <a href={X_URL} target="_blank" rel="noopener noreferrer" onclick="gtag('event','outbound_click',{destination:'x',location:'homepage'})">X (@karthiksync)</a>
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .home {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: calc(100vh - 16rem);
    max-width: 760px;
    margin: 0 auto;
    padding: 7rem 1.25rem 0;
    font-size: 1rem;
    color: var(--color-text-body);
  }

  .home a {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }

  .home a:hover {
    text-decoration-color: var(--highlight);
    text-decoration-thickness: 3px;
  }

  /* ── Intro ── */
  .intro h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.035em;
    max-width: 16ch;
    margin: 0 0 1.25rem;
  }

  .intro p {
    max-width: 58ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Sections ── */
  .block {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
  }

  .entry + .entry {
    margin-top: 1.5rem;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
  }

  .entry-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-desc {
    max-width: 60ch;
    margin: 0.35rem 0 0;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .entry-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .contact {
    margin: 0;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .home {
      padding: 3rem 1rem 0;
    }

  }
</style>
